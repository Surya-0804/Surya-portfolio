# ==========================================
# 📧 Email Configuration (For Contact Form)
# ==========================================
# The email address used to authenticate and send emails (e.g., your Gmail or Outlook)
EMAIL_USER="your-email@example.com"

# The App Password or account password for the email service
EMAIL_PASSWORD="your-app-password-or-secret"


# ==========================================
# 🤖 AI Chatbot Configuration
# ==========================================
# Mistral AI API Key (Used to power the primary chatbot on the portfolio)
# Get your API key at: https://console.mistral.ai/
MISTRAL_AI_API_KEY="your-mistral-api-key-here"

# (Deprecated/Optional) Google Gemini API Key
# Previously used for the chatbot before migrating to Mistral AI
GOOGLE_GENERATIVE_AI_API_KEY="your-google-gemini-api-key-here"
